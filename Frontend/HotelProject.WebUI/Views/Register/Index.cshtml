@model CreateNewUserDto
@{
    Layout = null;
    string errorMessage = (TempData["Error"] ?? ViewBag.Error)?.ToString();
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link href="~/auth/register.css" rel="stylesheet">
    <title>Kayıt Ol</title>
   </head>
<body>
    <div class="lg-page">
        <div class="lg-shell">

            <aside class="lg-aside">
                <div class="lg-brand">
                    <span class="lg-brand-mark">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l2.9 6.3L22 9.3l-5 4.9 1.2 7L12 18l-6.2 3.2 1.2-7-5-4.9 7.1-1z" /></svg>
                    </span>
                    Otel Yönetim Paneli
                </div>

                <div class="lg-aside-body">
                    <h2>Aramıza katılın</h2>
                    <p>Birkaç saniyede hesabınızı oluşturun, hizmetlerinizi ve kayıtlarınızı hemen yönetmeye başlayın.</p>
                </div>

                <ul class="lg-points">
                    <li>
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10" /><path d="M8 12.5l2.7 2.7L16 9.5" /></svg>
                        Ücretsiz ve hızlı kayıt
                    </li>
                    <li>
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10" /><path d="M8 12.5l2.7 2.7L16 9.5" /></svg>
                        Bilgileriniz güvende
                    </li>
                    <li>
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10" /><path d="M8 12.5l2.7 2.7L16 9.5" /></svg>
                        Her cihazdan erişim
                    </li>
                </ul>
            </aside>

            <main class="lg-main">
                <h1>Kayıt Ol</h1>
                <p class="lg-sub">Yeni hesap oluşturmak için bilgilerinizi doldurun.</p>

                @if (!string.IsNullOrWhiteSpace(errorMessage))
                {
                    <div class="lg-alert" role="alert">@errorMessage</div>
                }
                @* Controller, CreateAsync başarısız olduğunda hata eklemeden View() döndürüyor.
                   POST sonrası model geçerli olduğu halde sayfa geri geldiyse kayıt oluşturulamamıştır. *@
                @if (Context.Request.Method == "POST" && ViewData.ModelState.IsValid)
                {
                    <div class="lg-alert" role="alert">
                        Kayıt oluşturulamadı. Bu kullanıcı adı veya e-posta zaten kullanılıyor olabilir ya da şifre kurallara uymuyor
                        (en az 6 karakter; büyük harf, küçük harf, rakam ve özel karakter).
                    </div>
                }
                <div class="lg-alert lg-alert-summary" asp-validation-summary="ModelOnly" role="alert"></div>
                <div class="lg-alert" id="lgClientError" role="alert" hidden></div>

                <form id="lgForm" method="post" action="/Register/Index" novalidate>
                    @Html.AntiForgeryToken()

                    <div class="lg-grid">
                        <div class="lg-field">
                            <label class="lg-label" asp-for="Name">Ad</label>
                            <div class="lg-control">
                                <svg class="lg-ico" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" /><circle cx="12" cy="7" r="4" /></svg>
                                <input class="lg-input" asp-for="Name" type="text" placeholder="Adınız" autocomplete="given-name" autofocus />
                            </div>
                            <span class="lg-error" asp-validation-for="Name"></span>
                        </div>

                        <div class="lg-field">
                            <label class="lg-label" asp-for="Surname">Soyad</label>
                            <div class="lg-control">
                                <svg class="lg-ico" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" /><circle cx="12" cy="7" r="4" /></svg>
                                <input class="lg-input" asp-for="Surname" type="text" placeholder="Soyadınız" autocomplete="family-name" />
                            </div>
                            <span class="lg-error" asp-validation-for="Surname"></span>
                        </div>
                    </div>

                    <div class="lg-field">
                        <label class="lg-label" asp-for="Username">Kullanıcı Adı</label>
                        <div class="lg-control">
                            <svg class="lg-ico" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4" /><path d="M16 8v5a3 3 0 0 0 6 0v-1a10 10 0 1 0-4 8" /></svg>
                            <input class="lg-input" asp-for="Username" type="text" placeholder="Kullanıcı adınız" autocomplete="username" />
                        </div>
                        <span class="lg-error" asp-validation-for="Username"></span>
                    </div>

                    <div class="lg-field">
                        <label class="lg-label" asp-for="Mail">E-Posta</label>
                        <div class="lg-control">
                            <svg class="lg-ico" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2" /><path d="M22 7l-10 6L2 7" /></svg>
                            <input class="lg-input" asp-for="Mail" type="email" placeholder="ornek@@mail.com" autocomplete="email" />
                        </div>
                        <span class="lg-error" asp-validation-for="Mail"></span>
                    </div>

                    <div class="lg-grid">
                        <div class="lg-field">
                            <label class="lg-label" asp-for="Password">Şifre</label>
                            <div class="lg-control">
                                <svg class="lg-ico" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" /></svg>
                                <input class="lg-input has-toggle" asp-for="Password" type="password" placeholder="••••••••" autocomplete="new-password" data-pass />
                                <button type="button" class="lg-toggle" data-toggle aria-label="Şifreyi göster/gizle" title="Şifreyi göster/gizle">
                                    <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" /><circle cx="12" cy="12" r="3" /></svg>
                                </button>
                            </div>
                            <div class="lg-hint" data-caps>Caps Lock açık görünüyor.</div>
                            <span class="lg-error" asp-validation-for="Password"></span>
                            <div class="lg-note">En az 6 karakter; büyük harf, küçük harf, rakam ve özel karakter içermelidir.</div>
                            <div class="lg-meter" id="lgMeter" data-level="0">
                                <div class="lg-meter-bars"><i></i><i></i><i></i><i></i></div>
                                <div class="lg-meter-text" id="lgMeterText"></div>
                            </div>
                        </div>

                        <div class="lg-field">
                            <label class="lg-label" asp-for="ConfirmPassword">Şifre Tekrar</label>
                            <div class="lg-control">
                                <svg class="lg-ico" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" /></svg>
                                <input class="lg-input has-toggle" asp-for="ConfirmPassword" type="password" placeholder="••••••••" autocomplete="new-password" data-pass />
                                <button type="button" class="lg-toggle" data-toggle aria-label="Şifreyi göster/gizle" title="Şifreyi göster/gizle">
                                    <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" /><circle cx="12" cy="12" r="3" /></svg>
                                </button>
                            </div>
                            <div class="lg-hint" data-caps>Caps Lock açık görünüyor.</div>
                            <span class="lg-error" asp-validation-for="ConfirmPassword"></span>
                        </div>
                    </div>

                    <button type="submit" class="lg-submit" id="lgSubmit">
                        <span class="lg-spinner"></span>
                        <span id="lgSubmitText">Kayıt Ol</span>
                    </button>
                </form>

                <div class="lg-switch">Zaten hesabınız var mı? <a href="/Login/Index" class="lg-link">Giriş yapın</a></div>
                <div class="lg-foot">© @DateTime.Now.Year Tüm hakları saklıdır.</div>
            </main>
        </div>
    </div>

    <script>
        (function () {
            var form = document.getElementById('lgForm');
            var submit = document.getElementById('lgSubmit');
            var submitText = document.getElementById('lgSubmitText');
            var clientError = document.getElementById('lgClientError');
            var meter = document.getElementById('lgMeter');
            var meterText = document.getElementById('lgMeterText');

            var eyeOpen = '<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>';
            var eyeOff = '<path d="M17.94 17.94A10.9 10.9 0 0 1 12 20C5 20 1 12 1 12a18.5 18.5 0 0 1 5.06-5.94"/><path d="M9.9 4.24A10.9 10.9 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19"/><path d="M1 1l22 22"/>';

            var inputs = form.querySelectorAll('input.lg-input');
            var passInputs = form.querySelectorAll('[data-pass]');
            var password = passInputs[0];
            var confirm = passInputs[1];

            // Şifre göster / gizle (her alanın kendi butonu)
            form.querySelectorAll('[data-toggle]').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var input = btn.parentElement.querySelector('input');
                    var show = input.type === 'password';
                    input.type = show ? 'text' : 'password';
                    btn.querySelector('svg').innerHTML = show ? eyeOff : eyeOpen;
                    input.focus();
                });
            });

            // Caps Lock uyarısı
            passInputs.forEach(function (input) {
                var hint = input.closest('.lg-field').querySelector('[data-caps]');
                function check(e) { if (e.getModifierState) hint.classList.toggle('is-on', e.getModifierState('CapsLock')); }
                input.addEventListener('keydown', check);
                input.addEventListener('keyup', check);
                input.addEventListener('blur', function () { hint.classList.remove('is-on'); });
            });

            // Şifre gücü
            // var labels = ['', 'Zayıf', 'Orta', 'İyi', 'Güçlü'];
            // password.addEventListener('input', function () {
            //     var v = password.value, score = 0;
            //     if (v.length >= 8) score++;
            //     if (/[a-zçğıöşü]/.test(v) && /[A-ZÇĞİÖŞÜ]/.test(v)) score++;
            //     if (/\d/.test(v)) score++;
            //     if (/[^A-Za-z0-9çğıöşüÇĞİÖŞÜ]/.test(v)) score++;
            //     meter.classList.toggle('is-on', v.length > 0);
            //     meter.dataset.level = v.length ? Math.max(1, score) : 0;
            //     meterText.textContent = v.length ? 'Şifre gücü: ' + labels[Math.max(1, score)] : '';
            // });

            // Yazarken hata işaretini kaldır
            inputs.forEach(function (i) {
                i.addEventListener('input', function () { i.classList.remove('is-invalid'); clientError.hidden = true; });
            });

            function fail(message, field) {
                clientError.textContent = message;
                clientError.hidden = false;
                field.classList.add('is-invalid');
                field.focus();
            }

            form.addEventListener('submit', function (e) {
                clientError.hidden = true;

                for (var i = 0; i < inputs.length; i++) {
                    if (!inputs[i].value.trim()) {
                        e.preventDefault();
                        var label = form.querySelector('label[for="' + inputs[i].id + '"]');
                        return fail((label ? label.textContent : 'Bu alan') + ' alanı boş bırakılamaz.', inputs[i]);
                    }
                }

                var mail = form.querySelector('input[type="email"]');
                if (mail && !/^[^\s]+@@[^\s]+\.[^\s]+$/.test(mail.value.trim())) {
                    e.preventDefault();
                    return fail('Geçerli bir e-posta adresi girin.', mail);
                }

                if (password.value !== confirm.value) {
                    e.preventDefault();
                    return fail('Şifreler birbiriyle eşleşmiyor.', confirm);
                }

                submit.disabled = true;
                submit.classList.add('is-loading');
                submitText.textContent = 'Kayıt yapılıyor...';
            });
        })();
    </script>
</body>
</html>