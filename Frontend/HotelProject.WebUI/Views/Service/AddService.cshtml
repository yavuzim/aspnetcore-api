@model CreateServiceDto
@{
    ViewData["Title"] = "AddService";
    Layout = "~/Views/AdminLayout/_AdminLayout.cshtml";
}

<div class="form-card">
    <div class="form-card-header">
        <h4>Yeni Hizmet Girişi</h4>
        <small>Hizmet bilgilerini doldurup kaydedin.</small>
    </div>

    <form method="post" asp-action="AddService" asp-controller="Service">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <div class="form-section-title">Genel Bilgiler</div>
        <div class="row">
            <div class="form-group col-md-6">
                <label asp-for="ServiceIcon">Hizmet İkonu</label>
                <div class="input-icon">
                    <i class="fa fa-user"></i>
                    <input type="text" asp-for="ServiceIcon" class="form-control" placeholder="Hizmet İkonu" />
                </div>
                <span asp-validation-for="ServiceIcon" class="text-danger small"></span>
            </div>

            <div class="form-group col-md-6">
                <label asp-for="Title">Hizmet Başlığı</label>
                <div class="input-icon">
                    <i class="fa fa-briefcase"></i>
                    <input type="text" asp-for="Title" class="form-control" placeholder="Örn: Masaj" />
                </div>
                <span asp-validation-for="Title" class="text-danger small"></span>
            </div>
        </div>

        <div class="form-section-title mt-3">Sosyal Medya</div>
        <div class="row">
            <div class="form-group col-md-4">
                <label asp-for="Description">Açıklama</label>
                <div class="input-icon">
                    <i class="fa fa-audio-description"></i>
                    <input type="text" asp-for="Description" class="form-control" placeholder="Açıklama giriniz..." />
                </div>
                <span asp-validation-for="Description" class="text-danger small"></span>
            </div>
        </div>

        <div class="form-actions">
            <a asp-action="Index" class="btn btn-cancel">Vazgeç</a>
            <button type="submit" class="btn btn-save">
                <i class="fa fa-check mr-1"></i> Hizmet Ekle
            </button>
        </div>
    </form>
</div>

