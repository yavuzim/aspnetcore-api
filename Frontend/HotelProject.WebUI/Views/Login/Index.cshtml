@model LoginUserDto
@{
    Layout = null;
}
<!DOCTYPE html>
<html class="h-100" lang="tr">

<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>Giriş Yap</title>
    <!-- Favicon icon -->
    <link rel="icon" type="image/png" sizes="16x16" href="../../assets/images/favicon.png">
    <!-- <link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.5.0/css/all.css" integrity="sha384-B4dIYHKNBt8Bc12p+WXckhzcICo0wtJAoU8YZTY5qE0Id1GSseTk6S+L3BlXeVIU" crossorigin="anonymous"> -->
    <link href="~/auth/login.css" rel="stylesheet">
</head>

<body class="h-100">

    <!--*******************
        Preloader start
    ********************-->
    <div id="preloader">
        <div class="loader">
            <svg class="circular" viewBox="25 25 50 50">
                <circle class="path" cx="50" cy="50" r="20" fill="none" stroke-width="3" stroke-miterlimit="10" />
            </svg>
        </div>
    </div>
    <!--*******************
        Preloader end
    ********************-->

    <div class="lg-page">
        <div class="lg-shell">

            <aside class="lg-aside">
                <a class="lg-brand" href="index.html">
                    <span class="lg-brand-mark">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l2.9 6.3L22 9.3l-5 4.9 1.2 7L12 18l-6.2 3.2 1.2-7-5-4.9 7.1-1z" /></svg>
                    </span>
                    Rosella
                </a>

                <div class="lg-aside-body">
                    <h2>Tekrar hoş geldiniz</h2>
                    <p>Hizmetlerinizi, içeriklerinizi ve kayıtlarınızı tek bir yerden kolayca yönetin.</p>
                </div>

                <ul class="lg-points">
                    <li>
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10" /><path d="M8 12.5l2.7 2.7L16 9.5" /></svg>
                        Hızlı ve düzenli yönetim
                    </li>
                    <li>
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10" /><path d="M8 12.5l2.7 2.7L16 9.5" /></svg>
                        Güvenli oturum
                    </li>
                    <li>
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10" /><path d="M8 12.5l2.7 2.7L16 9.5" /></svg>
                        Her cihazdan erişim
                    </li>
                </ul>
            </aside>

            <main class="lg-main">
                <h1>Giriş Yap</h1>
                <p class="lg-sub">Devam etmek için hesap bilgilerinizi girin.</p>

                <form method="post">
                    <div class="lg-field">
                        <label class="lg-label">E-Posta</label>
                        <div class="lg-control">
                            <svg class="lg-ico" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2" /><path d="M22 7l-10 6L2 7" /></svg>
                            <input type="text" class="lg-input" placeholder="Kullanıcı Adınız">
                            <span asp-validation-for="Username" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="lg-field">
                        <label class="lg-label">Şifre</label>
                        <div class="lg-control">
                            <svg class="lg-ico" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" /></svg>
                            <input type="password" class="lg-input" placeholder="••••••••">
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>
                    </div>

                    <button class="lg-submit">Giriş Yap</button>
                </form>

                <div class="lg-switch">Hesabınız yok mu? <a href="/Register/Index" class="lg-link">Kayıt olun</a></div>
                <div class="lg-foot">© @DateTime.Now.Year Tüm hakları saklıdır.</div>
            </main>
        </div>
    </div>

    <!--**********************************
        Scripts
    ***********************************-->
    <script src="~/adminweb/plugins/common/common.min.js"></script>
    <script src="~/adminweb/js/custom.min.js"></script>
    <script src="~/adminweb/js/settings.js"></script>
    <script src="~/adminweb/js/gleek.js"></script>
    <script src="~/adminweb/js/styleSwitcher.js"></script>
</body>
</html>
