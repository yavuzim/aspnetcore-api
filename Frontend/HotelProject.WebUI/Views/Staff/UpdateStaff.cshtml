@model UpdateStaffViewModel
@{
    ViewData["Title"] = "Personel Güncelle";
    Layout = "~/Views/AdminLayout/_AdminLayout.cshtml";
}

<div class="form-card">
    <div class="form-card-header">
        <h4>Personel Güncelle</h4>
        <small>#@Model.StaffId numaralı personelin bilgilerini düzenleyin.</small>
    </div>

    <form method="post" asp-action="UpdateStaff" asp-controller="Staff">
        <input type="hidden" asp-for="StaffId" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <div class="form-section-title">Genel Bilgiler</div>
        <div class="row">
            <div class="form-group col-md-6">
                <label asp-for="Name">Personel Adı</label>
                <div class="input-icon">
                    <i class="fa fa-user"></i>
                    <input type="text" asp-for="Name" class="form-control" placeholder="Ad Soyad" />
                </div>
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>

            <div class="form-group col-md-6">
                <label asp-for="Title">Ünvanı</label>
                <div class="input-icon">
                    <i class="fa fa-briefcase"></i>
                    <input type="text" asp-for="Title" class="form-control" placeholder="Örn: Resepsiyon Görevlisi" />
                </div>
                <span asp-validation-for="Title" class="text-danger small"></span>
            </div>
        </div>

        <div class="form-section-title mt-3">Sosyal Medya</div>
        <div class="row">
            <div class="form-group col-md-4">
                <label asp-for="SocialMedia1">Sosyal Medya 1</label>
                <div class="input-icon">
                    <i class="fa fa-link"></i>
                    <input type="text" asp-for="SocialMedia1" class="form-control" placeholder="https://..." />
                </div>
                <span asp-validation-for="SocialMedia1" class="text-danger small"></span>
            </div>

            <div class="form-group col-md-4">
                <label asp-for="SocialMedia2">Sosyal Medya 2</label>
                <div class="input-icon">
                    <i class="fa fa-link"></i>
                    <input type="text" asp-for="SocialMedia2" class="form-control" placeholder="https://..." />
                </div>
                <span asp-validation-for="SocialMedia2" class="text-danger small"></span>
            </div>

            <div class="form-group col-md-4">
                <label asp-for="SocialMedia3">Sosyal Medya 3</label>
                <div class="input-icon">
                    <i class="fa fa-link"></i>
                    <input type="text" asp-for="SocialMedia3" class="form-control" placeholder="https://..." />
                </div>
                <span asp-validation-for="SocialMedia3" class="text-danger small"></span>
            </div>
        </div>

        <div class="form-actions">
            <a asp-action="Index" class="btn btn-cancel">Vazgeç</a>
            <button type="submit" class="btn btn-save">
                <i class="fa fa-check mr-1"></i> Güncelle
            </button>
        </div>
    </form>
</div>