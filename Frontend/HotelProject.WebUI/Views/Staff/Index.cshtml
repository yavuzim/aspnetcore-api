@model List<StaffViewModel>
@{
    ViewData["Title"] = "Personel Listesi";
    Layout = "~/Views/AdminLayout/_AdminLayout.cshtml";
}

<div class="staff-card">
    <div class="staff-header">
        <div>
            <h4>Personel Listesi</h4>
            <small>Toplam @Model.Count personel kayıtlı</small>
        </div>
        <a href="/Staff/AddStaff" class="btn btn-new-staff">
            <i class="fa fa-plus mr-1"></i> Yeni Personel Girişi
        </a>
    </div>

    <div class="table-responsive">
        <table class="staff-table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Personel Adı</th>
                    <th>Personel Ünvan</th>
                    <th class="text-center">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td><span class="staff-id">@item.StaffId</span></td>
                            <td>
                                <div class="staff-user">
                                    <div class="staff-avatar">
                                        @(string.IsNullOrEmpty(item.Name) ? "?" : item.Name.Substring(0, 1).ToUpper())
                                    </div>
                                    <span class="staff-name">@item.Name</span>
                                </div>
                            </td>
                            <td><span class="staff-title-badge">@item.Title</span></td>
                            <td>
                                <div class="action-group">
                                    <a href="#" class="action-btn detail" title="Detaylar"><i class="fa fa-eye"></i></a>
                                    <a href="/Staff/UpdateStaff/@item.StaffId" class="action-btn edit" title="Güncelle"><i class="fa fa-pencil"></i></a>
                                    <a href="/Staff/DeleteStaff/@item.StaffId" class="action-btn delete" title="Sil"><i class="fa fa-trash"></i></a>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4">
                            <div class="empty-state">
                                <i class="fa fa-users fa-2x mb-2"></i>
                                <p class="mb-0">Henüz kayıtlı personel bulunmuyor.</p>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>